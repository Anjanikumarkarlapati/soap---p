# Copy to .env (never commit .env). Used by docker-compose.yml and run-local.ps1.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# At least 32 random bytes, e.g.:  openssl rand -base64 48
JWT_SECRET=

EUREKA_SERVER_URL=http://localhost:8761/eureka
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend -> gateway URL (baked into the Next.js build)
PUBLIC_API_URL=http://localhost:8080

# Demo accounts + catalog (password123). Set false in production.
SEED_DEMO_DATA=true
